        <script><![CDATA[(function() {
    var PREFIX = 'EQ';
    var DIGIT_LENGTH = 7;

    var ga = new GlideAggregate('x_828868_tool_le_0_equipment');
    ga.addAggregate('MAX', 'serial_number');
    ga.query();

    var nextNum = 1;
    if (ga.next()) {
        var maxSerial = ga.getAggregate('MAX', 'serial_number');
        if (maxSerial) {
            var numPart = parseInt(maxSerial.replace(PREFIX, ''), 10);
            if (!isNaN(numPart)) {
                nextNum = numPart + 1;
            }
        }
    }

    var numStr = String(nextNum);
    while (numStr.length < DIGIT_LENGTH) {
        numStr = '0' + numStr;
    }
    current.setValue('serial_number', PREFIX + numStr);
})();]]></script>
