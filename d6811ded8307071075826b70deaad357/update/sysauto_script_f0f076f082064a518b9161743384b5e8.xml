    <script><![CDATA[(function() {
    var gr = new GlideRecord('x_828868_tool_le_0_loan_rec');
    gr.addQuery('status', 'active');
    gr.addQuery('due_date', '<', new GlideDateTime());
    gr.addQuery('return_date', '');
    gr.query();

    var count = 0;
    while (gr.next()) {
        gr.setValue('status', 'overdue');
        gr.update();
        count++;
    }

    gs.info('Flag Overdue Loans: ' + count + ' loan(s) marked as overdue.');
})();
]]></script>
